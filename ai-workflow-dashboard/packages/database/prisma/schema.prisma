// AI Workflow Automation Dashboard — Prisma schema (MVP scope per Section 5)
// Conventions: snake_case tables/columns, UUIDv7 primary keys, timestamptz in UTC,
// soft deletes via deleted_at, audit fields on primary entities.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================ Identity ============================

enum UserStatus {
  INVITED
  REGISTERED
  VERIFIED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  DEVELOPER
  OPERATOR
  VIEWER
  BILLING_ADMIN
  AUDITOR
}

model User {
  id            String     @id @default(uuid(7)) @db.Uuid
  email         String     @unique @db.VarChar(320)
  username      String     @unique @db.VarChar(64)
  displayName   String     @db.VarChar(128)
  passwordHash  String?    @map("password_hash") @db.VarChar(255)
  avatarUrl     String?    @map("avatar_url") @db.Text
  status        UserStatus @default(INVITED)
  timezone      String     @default("UTC") @db.VarChar(64)
  locale        String     @default("en") @db.VarChar(16)
  emailVerified Boolean    @default(false) @map("email_verified")
  lastLoginAt   DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships  Membership[]
  sessions     Session[]
  apiKeys      ApiKey[]
  auditLogs    AuditLog[]
  usageRecords UsageRecord[]
  createdKnowledgeBases KnowledgeBase[] @relation("KnowledgeBaseCreatedBy")

  @@index([status])
  @@map("users")
}

model Organization {
  id          String    @id @default(uuid(7)) @db.Uuid
  name        String    @db.VarChar(160)
  slug        String    @unique @db.VarChar(80)
  logoUrl     String?   @map("logo_url") @db.Text
  plan        String    @default("free") @db.VarChar(32)
  status      OrgStatus @default(ACTIVE)
  settings    Json?     @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  memberships   Membership[]
  workspaces    Workspace[]
  workflows     Workflow[]
  agents        Agent[]
  prompts       Prompt[]
  conversations Conversation[]
  integrations  Integration[]
  credentials   Credential[]
  executions    Execution[]
  auditLogs     AuditLog[]
  apiKeys       ApiKey[]
  usageRecords  UsageRecord[]
  knowledgeBases KnowledgeBase[]

  @@index([status])
  @@index([deletedAt])
  @@map("organizations")
}

model Membership {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  role           MembershipRole @default(VIEWER)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}

model Workspace {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(160)
  description    String?  @db.Text
  visibility     String   @default("private") @db.VarChar(32)
  createdById    String   @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflows    Workflow[]

  @@index([organizationId])
  @@map("workspaces")
}

model Session {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.VarChar(255)
  userAgent     String?   @map("user_agent") @db.Text
  ipAddress     String?   @map("ip_address") @db.VarChar(64)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model ApiKey {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.VarChar(128)
  hashedKey       String    @unique @map("hashed_key") @db.VarChar(255)
  keyPrefix      String    @map("key_prefix") @db.VarChar(16)
  permissions    String[]  @default([])
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(6)
  lastUsedAt     DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdById    String    @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@map("api_keys")
}

// ============================ Workflow ============================

enum WorkflowStatus {
  DRAFT
  VALIDATED
  PUBLISHED
  ARCHIVED
}

enum WorkflowTriggerType {
  MANUAL
  SCHEDULE
  WEBHOOK
  EVENT
}

enum ExecutionStatus {
  QUEUED
  INITIALIZING
  RUNNING
  WAITING
  RETRYING
  COMPLETED
  FAILED
  CANCELLED
  TIMED_OUT
}

enum NodeStatus {
  PENDING
  READY
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
  RETRYING
  WAITING
}

model Workflow {
  id              String              @id @default(uuid(7)) @db.Uuid
  organizationId  String              @map("organization_id") @db.Uuid
  workspaceId     String?             @map("workspace_id") @db.Uuid
  name            String              @db.VarChar(160)
  description     String?             @db.Text
  status          WorkflowStatus      @default(DRAFT)
  currentVersion  Int                 @default(0) @map("current_version")
  triggerType     WorkflowTriggerType @default(MANUAL) @map("trigger_type")
  scheduleCron    String?             @map("schedule_cron") @db.VarChar(128)
  scheduleTz      String?             @map("schedule_tz") @db.VarChar(64)
  webhookToken    String?             @unique @map("webhook_token") @db.VarChar(64)
  tags            String[]            @default([])
  isTemplate      Boolean             @default(false) @map("is_template")
  createdById     String              @map("created_by") @db.Uuid
  updatedById     String              @map("updated_by") @db.Uuid
  publishedAt     DateTime?           @map("published_at") @db.Timestamptz(6)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?           @map("deleted_at") @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  versions     WorkflowVersion[]
  executions   Execution[]

  @@index([organizationId, status])
  @@index([workspaceId])
  @@index([triggerType])
  @@map("workflows")
}

model WorkflowVersion {
  id             String   @id @default(uuid(7)) @db.Uuid
  workflowId     String   @map("workflow_id") @db.Uuid
  version        Int
  schemaVersion  Int      @default(1) @map("schema_version")
  checksum       String   @db.VarChar(64)
  definition     Json
  publishedById  String?  @map("published_by") @db.Uuid
  publishedAt    DateTime? @default(now()) @map("published_at") @db.Timestamptz(6)

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  nodes    WorkflowNode[]
  connections WorkflowConnection[]

  @@unique([workflowId, version])
  @@index([workflowId])
  @@map("workflow_versions")
}

model WorkflowNode {
  id                 String   @id @default(uuid(7)) @db.Uuid
  workflowVersionId  String   @map("workflow_version_id") @db.Uuid
  nodeKey            String   @map("node_key") @db.VarChar(80)
  nodeType           String   @map("node_type") @db.VarChar(64)
  category           String   @db.VarChar(32)
  positionX          Float    @map("position_x")
  positionY          Float    @map("position_y")
  configuration      Json     @default("{}")
  metadata           Json?    @default("{}")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workflowVersion WorkflowVersion      @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  executions      ExecutionNodeRecord[]

  @@index([workflowVersionId])
  @@map("workflow_nodes")
}

model WorkflowConnection {
  id                 String @id @default(uuid(7)) @db.Uuid
  workflowVersionId  String @map("workflow_version_id") @db.Uuid
  sourceNode         String @map("source_node") @db.VarChar(80)
  targetNode         String @map("target_node") @db.VarChar(80)
  sourcePort         String @map("source_port") @db.VarChar(64)
  targetPort         String @map("target_port") @db.VarChar(64)

  workflowVersion WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)

  @@index([workflowVersionId])
  @@map("workflow_connections")
}

model Execution {
  id               String          @id @default(uuid(7)) @db.Uuid
  organizationId   String          @map("organization_id") @db.Uuid
  workflowId       String          @map("workflow_id") @db.Uuid
  workflowVersion  Int             @map("workflow_version")
  status           ExecutionStatus @default(QUEUED)
  trigger          String          @default("MANUAL") @db.VarChar(32)
  input            Json?           @default("{}")
  startedAt        DateTime?       @map("started_at") @db.Timestamptz(6)
  completedAt      DateTime?       @map("completed_at") @db.Timestamptz(6)
  durationMs       Int?            @map("duration_ms")
  retryCount       Int             @default(0) @map("retry_count")
  correlationId    String          @map("correlation_id") @db.VarChar(64)
  error            String?         @db.Text
  errorCode        String?         @map("error_code") @db.VarChar(64)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflow     Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  nodes        ExecutionNodeRecord[]

  @@index([organizationId, status])
  @@index([workflowId, createdAt])
  @@index([status])
  @@index([correlationId])
  @@map("executions")
}

model ExecutionNodeRecord {
  id             String    @id @default(uuid(7)) @db.Uuid
  executionId    String    @map("execution_id") @db.Uuid
  workflowNodeId String?   @map("workflow_node_id") @db.Uuid
  nodeKey        String    @map("node_key") @db.VarChar(80)
  nodeType       String    @map("node_type") @db.VarChar(64)
  status         NodeStatus @default(PENDING)
  attempt        Int       @default(0)
  input          Json?     @default("{}")
  output         Json?     @default("{}")
  error          String?   @db.Text
  errorCode      String?   @map("error_code") @db.VarChar(64)
  aiUsage        Json?     @map("ai_usage") @default("{}")
  startedAt      DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(6)
  durationMs     Int?      @map("duration_ms")

  execution    Execution     @relation(fields: [executionId], references: [id], onDelete: Cascade)
  workflowNode WorkflowNode? @relation(fields: [workflowNodeId], references: [id], onDelete: SetNull)

  @@unique([executionId, nodeKey])
  @@index([executionId])
  @@index([workflowNodeId])
  @@index([executionId, status])
  @@map("execution_nodes")
}

model ExecutionLog {
  id           String   @id @default(uuid(7)) @db.Uuid
  executionId  String   @map("execution_id") @db.Uuid
  level        String   @db.VarChar(16)
  message      String   @db.Text
  nodeKey      String?  @map("node_key") @db.VarChar(80)
  metadata     Json?    @default("{}")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([executionId])
  @@map("execution_logs")
}

// ============================ AI ============================

enum AgentStatus {
  DRAFT
  VALIDATED
  PUBLISHED
  DEPRECATED
  ARCHIVED
}

model Agent {
  id               String      @id @default(uuid(7)) @db.Uuid
  organizationId   String      @map("organization_id") @db.Uuid
  name             String      @db.VarChar(160)
  description      String?     @db.Text
  status           AgentStatus @default(DRAFT)
  currentVersion   Int         @default(0) @map("current_version")
  provider         String      @default("ollama") @db.VarChar(32)
  model            String      @default("llama3.2") @db.VarChar(128)
  temperature      Float       @default(0.7)
  topP             Float       @default(1) @map("top_p")
  maxTokens        Int         @default(2048) @map("max_tokens")
  systemPrompt     String      @default("You are a helpful assistant.") @map("system_prompt") @db.Text
  memoryPolicy     String      @default("none") @map("memory_policy") @db.VarChar(32)
  tokenBudget      Int?        @map("token_budget")
  createdById      String      @map("created_by") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?   @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("agents")
}

model Prompt {
  id              String    @id @default(uuid(7)) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  title           String    @db.VarChar(160)
  content         String    @db.Text
  version         Int       @default(1)
  status          String    @default("DRAFT") @db.VarChar(32)
  tags            String[]  @default([])
  createdById     String    @map("created_by") @db.Uuid
  publishedAt     DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("prompts")
}

model Conversation {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  agentId        String?   @map("agent_id") @db.Uuid
  title          String    @default("New conversation") @db.VarChar(160)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@index([organizationId])
  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid(7)) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  role           String   @db.VarChar(16)
  content        String   @db.Text
  model          String?  @db.VarChar(128)
  provider       String?  @db.VarChar(32)
  tokenUsage     Json?    @map("token_usage") @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

// ============================ Integration ============================

enum CredentialStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

model Integration {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  provider       String   @db.VarChar(64)
  category       String   @db.VarChar(32)
  name           String   @db.VarChar(160)
  configuration  Json?    @default("{}")
  healthStatus   String   @default("UNKNOWN") @map("health_status") @db.VarChar(32)
  lastSyncAt     DateTime? @map("last_sync_at") @db.Timestamptz(6)
  createdById    String   @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, provider])
  @@map("integrations")
}

model Credential {
  id                    String           @id @default(uuid(7)) @db.Uuid
  organizationId        String           @map("organization_id") @db.Uuid
  name                  String           @db.VarChar(160)
  provider              String           @db.VarChar(64)
  encryptedSecretRef    String           @map("encrypted_secret_reference") @db.Text
  status                CredentialStatus @default(ACTIVE)
  expiresAt             DateTime?        @map("expires_at") @db.Timestamptz(6)
  lastUsedAt            DateTime?        @map("last_used_at") @db.Timestamptz(6)
  createdById           String           @map("created_by") @db.Uuid
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime?        @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, provider])
  @@map("credentials")
}

// ============================ Knowledge / RAG ============================

model KnowledgeBase {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(160)
  description    String?  @db.Text
  provider       String   @default("ollama") @db.VarChar(64)
  embeddingModel String   @default("nomic-embed-text") @map("embedding_model") @db.VarChar(96)
  chunkSize      Int      @default(512) @map("chunk_size")
  chunkOverlap   Int      @default(64) @map("chunk_overlap")
  status         String   @default("ACTIVE") @db.VarChar(32)
  createdById    String   @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User                 @relation("KnowledgeBaseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  documents    KnowledgeDocument[]

  @@index([organizationId])
  @@map("knowledge_bases")
}

model KnowledgeDocument {
  id              String    @id @default(uuid(7)) @db.Uuid
  knowledgeBaseId String    @map("knowledge_base_id") @db.Uuid
  filename        String    @db.VarChar(255)
  mimeType        String?   @map("mime_type") @db.VarChar(96)
  size            Int       @default(0)
  checksum        String?   @db.VarChar(96)
  storagePath     String?   @map("storage_path") @db.Text
  indexedAt       DateTime? @map("indexed_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  chunks        Embedding[]

  @@index([knowledgeBaseId])
  @@map("knowledge_documents")
}

model Embedding {
  id         String   @id @default(uuid(7)) @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  chunkIndex Int      @map("chunk_index")
  content    String   @db.Text
  embedding  Json
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([documentId])
  @@map("embeddings")
}

// ============================ Analytics ============================

model AuditLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  actorType      String   @default("user") @map("actor_type") @db.VarChar(16)
  action         String   @db.VarChar(96)
  entity         String   @db.VarChar(64)
  entityId       String?  @map("entity_id") @db.VarChar(64)
  ipAddress      String?  @map("ip_address") @db.VarChar(64)
  userAgent      String?  @map("user_agent") @db.Text
  metadata       Json?    @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor        User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model UsageRecord {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  executionId    String?  @map("execution_id") @db.Uuid
  kind           String   @db.VarChar(32)
  provider       String?  @db.VarChar(32)
  model          String?  @db.VarChar(128)
  quantity       Float    @default(0)
  unit           String   @default("tokens") @db.VarChar(32)
  costUsd        Float    @default(0) @map("cost_usd")
  metadata       Json?    @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([kind, createdAt])
  @@map("usage_records")
}
