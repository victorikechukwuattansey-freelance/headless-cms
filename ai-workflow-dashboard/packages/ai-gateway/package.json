{
    "name":  "@awd/ai-gateway",
    "version":  "0.1.0",
    "private":  true,
    "main":  "dist/index.js",
    "types":  "dist/index.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./dist/index.d.ts",
                              "import":  "./dist/index.js",
