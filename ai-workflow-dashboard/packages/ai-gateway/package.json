                },
    "dependencies":  {
                         "@awd/config":  "workspace:*",
                         "@awd/logger":  "workspace:*"
                     },
    "devDependencies":  {
                            "typescript":  "^5.7.0",
                            "vitest":  "^2.1.0"
                        }
}
