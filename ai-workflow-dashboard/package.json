{
  "name": "ai-workflow-dashboard",
  "private": true,
  "description": "AI Workflow Automation Dashboard — MVP per master engineering specification",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "typecheck": "turbo typecheck",
    "db:generate": "pnpm --filter @awd/database db:generate",
    "db:migrate": "pnpm --filter @awd/database db:migrate",
    "db:seed": "pnpm --filter @awd/database db:seed",
    "db:studio": "pnpm --filter @awd/database db:studio",
    "api:dev": "pnpm --filter @awd/api dev",
    "worker:dev": "pnpm --filter @awd/worker dev",
    "web:dev": "pnpm --filter @awd/web dev"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.5.0",
    "turbo": "^2.5.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  }
}
