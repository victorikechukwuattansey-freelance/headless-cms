    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst lead = item.lead || {};\nconst nowIso = new Date().toISOString();\n\n// Persisted values: preserve existing data unless this update changes it.\n// booked_at / booking_id are NEVER fabricated — only used when supplied by the request\n// on a transition to booked.\nconst updated = {\n  lead_id: String(lead.lead_id || ''),\n  business_id: String(lead.business_id || ''),\n  status: item.new_status,\n  updated_at: nowIso,\n  notes: item.notes_in || String(lead.notes || ''),\n  next_followup_at: item._terminal ? '' : String(lead.next_followup_at || ''),\n  booked:\n    item.new_status === 'booked' ? 'TRUE' : String(lead.booked == null ? '' : lead.booked),\n  booked_at:\n    item.new_status === 'booked'\n      ? item.supplied_booked_at || String(lead.booked_at || '')\n      : String(lead.booked_at || ''),\n  booking_id:\n    item.new_status === 'booked'\n      ? item.supplied_booking_id || String(lead.booking_id || '')\n      : String(lead.booking_id || '')\n};\n\nreturn [\n  {\n    json: Object.assign({}, updated, {\n      old_status: item.old_status,\n      new_status: item.new_status,\n      updated_by: item.updated_by,\n      owner_email: item.owner_email,\n      from_email: item.from_email,\n      reply_to_email: item.reply_to_email,\n      business_name: item.business_name,\n      _esc_lead_id: esc(updated.lead_id),\n      _esc_business_name: esc(item.business_name),\n      _esc_name: esc(lead.name),\n      _esc_old_status: esc(item.old_status),\n      _esc_new_status: esc(item.new_status),\n      _esc_updated_by: esc(item.updated_by),\n      _esc_notes: esc(updated.notes)\n    })\n  }\n];\n\nfunction esc(v) {\n  return String(v == null ? '' : v)\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\"/g, '&quot;')\n    .replace(/'/g, '&#39;');\n}"
      },
