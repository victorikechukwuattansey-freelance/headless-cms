    {
      "parameters": {
        "jsCode": "const input=$input.first().json;\nconst rows=$('Read Existing Leads').all();\nconst row=rows.find(r=>String(r.json.lead_id||'').trim()===input.lead_id && String(r.json.business_id||'').trim()===input.business_id);\nreturn [{json:{...input,_leadFound:!!row,lead:row?row.json:null}}];"
      },
