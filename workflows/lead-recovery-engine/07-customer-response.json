      "parameters": {
        "jsCode": "const webhook = $('Customer Response Webhook').first().json;\nconst body = webhook.body ?? webhook;\nconst businessId = String(body.business_id || '').trim();\nconst leadId = String(body.lead_id || '').trim();\nconst responseMessage = String(body.message || body.response || '').trim();\nif (!businessId || !leadId) return [{json:{_valid:false,error:'missing_field',field:'business_id|lead_id',code:400}}];\nreturn [{json:{...body,business_id:businessId,lead_id:leadId,customer_response:responseMessage,received_at:new Date().toISOString(),_valid:true}}];"
      },
      "id": "normalize-response",
      "name": "Normalize Customer Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
