    {
      "parameters": {
        "jsCode": "const webhook = $('Status Update Webhook').first().json;\nconst body = webhook.body ?? webhook;\n\nconst configs = $('Get Business Config').all();\nconst leads = $('Read Existing Leads').all();\n\nconst bid = String(body.business_id || '').trim();\nconst cfgRow =\n  configs.find((c) => String(c.json.business_id || '').trim() === bid) || null;\nconst cj = cfgRow ? cfgRow.json : null;\n\n// Strict tenant-scoped resolution: lead_id + business_id only.\nconst wantId = String(body.lead_id || '').trim();\nconst leadRow =\n  leads.find(\n    (r) =>\n      String(r.json.lead_id || '').trim() === wantId &&\n      String(r.json.business_id || '').trim() === bid\n  ) || null;\n\nconst ALLOWED = ['new', 'contacted', 'qualified', 'booked', 'lost', 'no_response', 'closed'];\nconst newStatus = body.new_status ? String(body.new_status).trim().toLowerCase() : '';\n\nfunction esc(v) {\n  return String(v == null ? '' : v)\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\"/g, '&quot;')\n    .replace(/'/g, '&#39;');\n}\n\nreturn [\n  {\n    json: {\n      _configFound: !!cj,\n      _active: !!cj && String(cj.active || '').trim().toLowerCase() === 'true',\n      _leadFound: !!leadRow,\n      _statusValid: ALLOWED.indexOf(newStatus) !== -1,\n      // Terminal statuses stop all future follow-ups.\n      _terminal: ['booked', 'lost', 'closed', 'no_response'].indexOf(\n  leadRow ? String(leadRow.json.status || '').trim().toLowerCase() : ''\n) !== -1,\n      lead: leadRow ? leadRow.json : null,\n      old_status: leadRow ? String(leadRow.json.status || '') : '',\n      new_status: newStatus,\n      supplied_booked_at: body.booked_at ? String(body.booked_at) : '',\n      supplied_booking_id: body.booking_id ? String(body.booking_id) : '',\n      updated_by: body.updated_by ? String(body.updated_by) : 'operator',\n      notes_in: body.notes ? String(body.notes) : '',\n      owner_email: cj ? cj.owner_email || '' : '',\n      from_email: cj ? cj.from_email || '' : '',\n      reply_to_email: cj ? cj.reply_to_email || '' : '',\n      business_name: cj ? cj.business_name || '' : '',\n      _esc_business_name: esc(cj ? cj.business_name || '' : ''),\n      _esc_name: leadRow ? esc(leadRow.json.name) : ''\n    }\n  }\n];"
      },
