    {
      "parameters": {
        "jsCode": "// $input here is the output of the Google Sheets 'Update Lead' node, which\n// replaces $json with the sheet row. old_status / new_status / updated_by are\n// not sheet columns, so they are lost there. Read them from the node that\n// computed them, before the sheet update.\nconst item = $('Prepare Updated Lead').first().json;\nreturn [\n  {\n    json: {\n      update_id: 'upd_' + Date.now() + '_' + Math.random().toString(36).slice(2, 8),\n      created_at: new Date().toISOString(),\n      lead_id: item.lead_id,\n      business_id: item.business_id,\n      old_status: item.old_status,\n      new_status: item.new_status,\n      updated_by: item.updated_by,\n      notes: item.notes || ''\n    }\n  }\n];"
      },
