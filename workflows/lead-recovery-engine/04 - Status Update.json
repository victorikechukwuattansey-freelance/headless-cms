    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nconst newStatus = String(input.new_status || '').trim().toLowerCase();\n\nconst bookingId = String(\n  input.supplied_booking_id ??\n  input.booking_id ??\n  ''\n).trim();\n\nconst bookedAt = String(\n  input.supplied_booked_at ??\n  input.booked_at ??\n  ''\n).trim();\n\n// Only booked transitions require booking data.\nif (newStatus === 'booked') {\n  const missing = [];\n\n  if (!bookingId) missing.push('booking_id');\n  if (!bookedAt) missing.push('booked_at');\n\n  if (missing.length > 0) {\n    return [{\n      json: {\n        ...input,\n        _bookingValid: false,\n        error: 'missing_booking_data',\n        fields: missing,\n        code: 422\n      }\n    }];\n  }\n}\n\nreturn [{\n  json: {\n    ...input,\n    _bookingValid: true,\n    booking_id: bookingId,\n    booked_at: bookedAt\n  }\n}];"
      },
