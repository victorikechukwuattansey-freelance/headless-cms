      "id": "e0c8f976-b910-44ee-b506-30dbea6180ed",
      "name": "Get Business Config",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 3,
      "position": [
        624,
        0
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
