    {
      "parameters": {
        "jsCode": "const webhook = $('Booking Status Webhook').first().json;\nconst body = webhook.body ?? webhook;\n\nconst leads = $('Read Existing Leads').all();\nconst bookings = $('Read Existing Bookings').all();\nconst cfgJson = $('Get Business Config').first()?.json ?? null;\n\nconst bid = body.business_id ? String(body.business_id).trim() : '';\n\n// Exact business_id match only: a lead can never be resolved against another business's config.\nconst config =\n  cfgJson && String(cfgJson.business_id || '').trim() === bid ? cfgJson : null;\n\nfunction digits(v) {\n  return String(v || '').replace(/\\D/g, '');\n}\n\n// Resolution order (tenant-scoped): lead_id+business_id -> phone+business_id -> email+business_id.\nlet lead = null;\nconst wantId = body.lead_id ? String(body.lead_id).trim() : '';\nif (wantId) {\n  lead =\n    leads.find(\n      (r) =>\n        String(r.json.lead_id || '').trim() === wantId &&\n        String(r.json.business_id || '').trim() === bid\n    ) || null;\n}\nif (!lead && body.phone) {\n  const p = digits(body.phone);\n  if (p) {\n    lead =\n      leads.find(\n        (r) => digits(r.json.phone) === p && String(r.json.business_id || '').trim() === bid\n      ) || null;\n  }\n}\nif (!lead && body.email) {\n  const e = String(body.email).trim().toLowerCase();\n  if (e) {\n    lead =\n      leads.find(\n        (r) =>\n          String(r.json.email || '').trim().toLowerCase() === e &&\n          String(r.json.business_id || '').trim() === bid\n      ) || null;\n  }\n}\n\n// Idempotent replay detection: same booking_id within the same business already recorded?\nconst incomingBookingId = body.booking_id ? String(body.booking_id).trim() : '';\nconst duplicateBooking = !!(\n  incomingBookingId &&\n  bookings.some(\n    (r) =>\n      String(r.json.booking_id || '').trim() === incomingBookingId &&\n      String(r.json.business_id || '').trim() === bid\n  )\n);\n\nconst booking = {\n  booking_id:\n    incomingBookingId || 'bk_' + Date.now() + '_' + Math.random().toString(36).slice(2, 10),\n  lead_id: lead ? String(lead.json.lead_id || '') : wantId,\n  business_id: bid,\n  created_at: new Date().toISOString(),\n  booking_at: body.booking_at ? String(body.booking_at) : new Date().toISOString(),\n  source: body.source ? String(body.source) : 'booking_provider',\n  status: body.status ? String(body.status) : 'confirmed'\n};\n\nfunction esc(v) {\n  return String(v == null ? '' : v)\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\"/g, '&quot;')\n    .replace(/'/g, '&#39;');\n}\n\nreturn [\n  {\n    json: {\n      _leadFound: !!lead,\n      _configFound: !!config,\n      _duplicateBooking: duplicateBooking,\n      lead: lead ? lead.json : null,\n      booking: booking,\n      business_name: config ? config.business_name || '' : '',\n      owner_email: config ? config.owner_email || '' : '',\n      reply_to_email: config ? config.reply_to_email || '' : '',\n      from_email: config ? config.from_email || '' : '',\n      _esc_lead_id: esc(booking.lead_id),\n      _esc_booking_id: esc(booking.booking_id),\n      _esc_business_name: esc(config ? config.business_name || '' : ''),\n      _esc_name: lead ? esc(lead.json.name) : '',\n      _esc_phone: lead ? esc(lead.json.phone) : '',\n      _esc_service: lead ? esc(lead.json.service) : '',\n      _esc_booking_at: esc(booking.booking_at),\n      _esc_booking_link: lead ? esc(lead.json.booking_link) : ''\n    }\n  }\n];"
      },
