    },
    {
      "parameters": {
        "jsCode": "const r = $('Resolve Lead & Booking').first().json;\nconst lead = r.lead || {};\nconst b = r.booking || {};\nconst now = new Date().toISOString();\n\n// Prefer the stable webhook lead_id when supplied; fall back to the resolved lead.\nconst webhook = $('Booking Status Webhook').first().json;\nconst body = webhook.body ?? webhook;\nconst whLeadId = body.lead_id ? String(body.lead_id).trim() : '';\nconst matchLeadId = whLeadId || String(lead.lead_id || b.lead_id || '');\n\n// Capture status BEFORE Update Lead Booked changes it.\nconst oldStatus = String(lead.status || '').trim();\n\nreturn [\n  {\n    json: Object.assign({}, lead, {\n      lead_id: matchLeadId,\n\n      // Booking update\n      booked: 'TRUE',\n      booked_at: b.booking_at,\n      booking_id: b.booking_id,\n      status: 'booked',\n      next_followup_at: '',\n      updated_at: now,\n\n      // Status audit information\n      _old_status: oldStatus,\n      _new_status: 'booked',\n      _updated_by: 'booking_status',\n      _status_update_notes: b.booking_id\n        ? `Booking ID: ${b.booking_id}`\n        : 'Lead booked',\n\n      booking_link: lead.booking_link || '',\n      business_name: r.business_name,\n      owner_email: r.owner_email,\n      from_email: r.from_email,\n      reply_to_email: r.reply_to_email,\n\n      _esc_lead_id: r._esc_lead_id,\n      _esc_booking_id: r._esc_booking_id,\n      _esc_business_name: r._esc_business_name,\n      _esc_name: r._esc_name,\n      _esc_phone: r._esc_phone,\n      _esc_service: r._esc_service,\n      _esc_booking_at: r._esc_booking_at,\n      _esc_booking_link: r._esc_booking_link\n    })\n  }\n];"
      },
