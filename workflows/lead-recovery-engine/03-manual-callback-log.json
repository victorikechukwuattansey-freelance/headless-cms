    {
      "parameters": {
        "jsCode": "const rows = $input.all();\nconst lead = $('Resolve Config & Normalize Callback').first().json;\nconst key = String(lead.idempotency_key || '');\nconst srcId = String(lead.source_id || '');\nconst bid = String(lead.business_id || '').trim();\nconst normPhone = String(lead.phone || '').replace(/\\D/g, '');\nconst normEmail = String(lead.email || '').trim().toLowerCase();\nlet reason = '';\nconst dup = rows.some((r) => {\n  const j = r.json;\n  const rowBid = String(j.business_id || '').trim();\n  // Tenant-scoped duplicate order matching Lead Intake V4.3.\n  if (key && j.idempotency_key && String(j.idempotency_key) === key && rowBid === bid) { reason = 'idempotency_key'; return true; }\n  if (srcId && j.source_id && String(j.source_id) === srcId && String(j.source_type || '') === 'manual_callback' && rowBid === bid) { reason = 'source_id'; return true; }\n  if (normPhone && j.phone && rowBid === bid && String(j.phone).replace(/\\D/g, '') === normPhone) { reason = 'phone'; return true; }\n  if (normEmail && j.email && rowBid === bid && String(j.email).trim().toLowerCase() === normEmail) { reason = 'email'; return true; }\n  return false;\n});\nreturn [{ json: Object.assign({}, lead, { _isDuplicate: dup, _duplicateReason: reason }) }];"
      },
