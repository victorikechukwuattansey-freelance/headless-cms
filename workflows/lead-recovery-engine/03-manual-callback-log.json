      "id": "node-cb-getconfig",
      "name": "Get Business Config",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 3,
      "position": [-944, -16],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "WKOG2OGDN34LtGmz",
          "name": "Google Sheets account"
        }
      },
      "notes": "Reads ALL business_config rows; exact-match tenant scoping happens in the Code node (live-validated pattern)."
    },
    {
      "parameters": {
        "jsCode": "const webhook = $('Manual Callback Webhook').first().json;\nconst body = webhook.body ?? webhook;\n\n// Exact business_id match only.\nconst cfgJson = $('Get Business Config').first()?.json ?? null;\nconst businessId = body.business_id ? String(body.business_id).trim() : '';\nconst cj =\n  cfgJson && String(cfgJson.business_id || '').trim() === businessId ? cfgJson : null;\n\nconst _configFound = !!cj;\nconst _active =\n  _configFound && String(cj.active || '').trim().toLowerCase() === 'true';\n\nconst now = new Date();\n\nfunction rid(prefix) {\n  return prefix + '_' + now.getTime() + '_' + Math.random().toString(36).slice(2, 10);\n}\n\nfunction esc(v) {\n  return String(v == null ? '' : v)\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\"/g, '&quot;')\n    .replace(/'/g, '&#39;');\n}\n\n// Runtime-compatible booking-link validation.\n// Do NOT use the URL constructor (unavailable in the n8n Cloud Code node sandbox).\nfunction safeBookingLink(value, leadId) {\n  let raw = String(value || '').trim();\n  if (!raw) return '';\n  raw = raw.replace(/\\{\\{\\s*lead_id\\s*\\}\\}/g, encodeURIComponent(leadId));\n  if (!/^https:\\/\\/[^\\s\"'<>]+$/i.test(raw)) return '';\n  if (/[\\r\\n<>\"'`]/.test(raw)) return '';\n  if (/[?&]lead_id=/.test(raw)) return raw;\n  return raw + (raw.includes('?') ? '&' : '?') + 'lead_id=' + encodeURIComponent(leadId);\n}\n\nconst email = String(body.email || '').trim().toLowerCase();\nconst phone = String(body.phone || '').trim();\nconst normPhone = phone.replace(/\\D/g, '');\nconst message = body.message || '';\nconst service = body.service || '';\n\n// Deterministic idempotency key for manual callbacks (explicit key wins).\nconst idempotencyKey = body.idempotency_key\n  ? String(body.idempotency_key)\n  : ['manual_callback', businessId, normPhone, email].join('|');\n\nconst leadId = rid('lead');\nconst bookingLink = safeBookingLink(cj ? cj.booking_link : '', leadId);\n\nconst lead = {\n  lead_id: leadId,\n  business_id: businessId,\n  created_at: now.toISOString(),\n  updated_at: now.toISOString(),\n  source_type: 'manual_callback',\n  source_id: body.source_id ? String(body.source_id).trim() : '',\n  name: body.name || '',\n  phone: phone,\n  email: email,\n  message: message,\n  service: service,\n  niche: body.niche || (cj ? cj.niche || '' : '') || '',\n  city: body.city || '',\n  state: body.state || '',\n  zip: body.zip || '',\n  urgency: 'normal',\n  score: 50,\n  status: 'new',\n  booking_link: bookingLink,\n  booking_link_sent: false,\n  booked: false,\n  followup_count: 0,\n  next_followup_at: '',\n  last_contact_at: '',\n  last_customer_response_at: '',\n  idempotency_key: idempotencyKey,\n  notes: body.notes || 'Manual callback entry'\n};\n\nconst merged = Object.assign({}, lead, {\n  _configFound: _configFound,\n  _active: _active,\n  _autoCustomerEmail:\n    _configFound && String(cj.auto_customer_email || '').trim().toLowerCase() === 'true',\n  _fromEmailPresent: !!(cj && cj.from_email),\n  _replyToPresent: !!(cj && cj.reply_to_email),\n  _bookingLinkPresent: !!bookingLink,\n  business_name: cj ? cj.business_name || '' : '',\n  owner_name: cj ? cj.owner_name || '' : '',\n  owner_email: cj ? cj.owner_email || '' : '',\n  reply_to_email: cj ? cj.reply_to_email || '' : '',\n  from_email: cj ? cj.from_email || '' : '',\n  followup_delay_hours: cj ? Number(cj.followup_delay_hours || 24) || 24 : 24,\n  max_followups: cj ? Number(cj.max_followups || 3) || 3 : 3,\n  timezone: cj ? cj.timezone || 'Africa/Lagos' : 'Africa/Lagos',\n  _esc_lead_id: esc(lead.lead_id),\n  _esc_business_name: esc(cj ? cj.business_name || '' : ''),\n  _esc_name: esc(lead.name),\n  _esc_phone: esc(phone),\n  _esc_email: esc(email),\n  _esc_service: esc(service),\n  _esc_message: esc(message),\n  _esc_booking_link: esc(bookingLink),\n  _esc_created_at: esc(lead.created_at),\n  _esc_notes: esc(lead.notes)\n});\n\nreturn [{ json: merged }];"
      },
