    {
      "parameters": {
        "jsCode": "const webhook = $('Customer Response Webhook').first().json;\n\nconst body = webhook.body ?? webhook;\n\nconst businessId = String(body.business_id || '').trim();\nconst leadId = String(body.lead_id || '').trim();\nconst responseMessage = String(body.message || body.response || '').trim();\n\nif (!businessId || !leadId) {\n  return [{\n    json: {\n      _valid: false,\n      error: 'missing_field',\n      field: 'business_id|lead_id',\n      code: 400\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    _valid: true,\n    business_id: businessId,\n    lead_id: leadId,\n    customer_response: responseMessage,\n    received_at: new Date().toISOString()\n  }\n}];"
      },
