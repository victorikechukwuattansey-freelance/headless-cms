    {
      "parameters": {
        "jsCode": "const input = $('Normalize Customer Response').first().json;\nconst rows = $('Read Existing Leads').all();\n\nconst row = rows.find(r =>\n  String(r.json.lead_id || '').trim() === String(input.lead_id || '').trim() &&\n  String(r.json.business_id || '').trim() === String(input.business_id || '').trim()\n);\n\nreturn [\n  {\n    json: {\n      ...input,\n      _leadFound: !!row,\n      lead: row ? row.json : null\n    }\n  }\n];"
      },
