# ──────────────────────────────────────────────
# Social Media OS — Environment Configuration
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# ──────────────────────────────────────────────

# ── Database ──────────────────────────────
DATABASE_URL=postgresql://smos:smos_secret@localhost:5432/social_media_os
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_SSL=true

# ── Cache ─────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ── Authentication ────────────────────────
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_REFRESH_SECRET=change-me-to-another-random-64-char-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── AI Providers ──────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-pro-exp

# ── Frontend ──────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-random-32-char-string

# ── Social: Facebook ──────────────────────
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_API_VERSION=v19.0
FACEBOOK_WEBHOOK_VERIFY_TOKEN=

# ── Social: Instagram ─────────────────────
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# ── Social: X / Twitter ───────────────────
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_BEARER_TOKEN=
TWITTER_API_VERSION=2

# ── Social: LinkedIn ──────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ORGANIZATION_ID=

# ── Social: TikTok ────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ── Social: Pinterest ─────────────────────
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# ── Social: YouTube ───────────────────────
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_API_KEY=

# ── Payments ──────────────────────────────
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PRICE_MONTHLY=price_monthly
STRIPE_PRICE_YEARLY=price_yearly
STRIPE_PRICE_ENTERPRISE=price_enterprise

# ── Monitoring ────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
POSTHOG_KEY=
POSTHOG_HOST=https://app.posthog.com
DATADOG_API_KEY=
DATADOG_SITE=datadoghq.com

# ── Email & Notifications ─────────────────
RESEND_API_KEY=re_
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@socialmediaos.com
SLACK_WEBHOOK_URL=

# ── Object Storage ────────────────────────
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_MEDIA=smos-media
S3_BUCKET_ASSETS=smos-assets
S3_BUCKET_EXPORTS=smos-exports
CLOUDFRONT_DOMAIN=

# ── Feature Flags ─────────────────────────
FF_AI_SUGGESTIONS=true
FF_SCHEDULING=true
FF_ANALYTICS=true
FF_TEAM_COLLAB=true
FF_WHITE_LABEL=false

# ── Rate Limiting ─────────────────────────
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ── Queue ─────────────────────────────────
QUEUE_CONCURRENCY=10
QUEUE_RETRY_MAX=3
QUEUE_RETRY_DELAY=5000

# ── Encryption ────────────────────────────
ENCRYPTION_KEY=change-me-to-a-32-byte-hex-string

# ── Webhooks ──────────────────────────────
WEBHOOK_SECRET=
WEBHOOK_MAX_RETRIES=5
