generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Report {
  id                String      @id @default(cuid())
  summary           String
  failureType       String
  rootCause         String
  confidence        Float
  recommendedFix    String
  preventionStrategy String
  sourceFormat      String
  stepCount         Int         @default(0)
  evidenceCount     Int         @default(0)
  redactions        Int         @default(0)
  createdAt         DateTime    @default(now())
  steps             ReportStep[]
  evidences         Evidence[]
}

model ReportStep {
  id        String   @id @default(cuid())
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  order     Int
  kind      String
  label     String
  content   String   @db.Text
  outcome   String?
  tokensIn  Int?
  tokensOut Int?
}

model Evidence {
  id       String   @id @default(cuid())
  reportId String
  report   Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  label    String
  detail   String   @db.Text
  severity String
}
