generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ============================================================
// ENUMS
// ============================================================

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  CANCELLED
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  SALES
  MARKETING
  INVENTORY
  FINANCE
  AUTHENTICATION_SPECIALIST
  CUSTOMER_SUPPORT
  CUSTOM
}

enum ProductCategory {
  BAGS
  SHOES
  WATCHES
  JEWELRY
  SUNGLASSES
  CLOTHING
  ACCESSORIES
}

enum ProductCondition {
  NEW
  LIKE_NEW
  EXCELLENT
  VERY_GOOD
  GOOD
  FAIR
  POOR
}

enum ProductStatus {
  DRAFT
  ACTIVE
  RESERVED
  SOLD
  ARCHIVED
}

enum InventoryStatus {
  AVAILABLE
  RESERVED
  SOLD
  INCOMING
  CONSIGNMENT
  DAMAGED
  RETURNED
  LOST
}

enum Gender {
  MALE
  FEMALE
  UNISEX
}

enum AuthenticationStatus {
  PENDING
  IN_PROGRESS
  AUTHENTIC
  COUNTERFEIT
  INCONCLUSIVE
  EXPERT_REVIEW
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  REFUNDED
  CANCELLED
  OVERDUE
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
  ARCHIVED
}

enum LeadSource {
  WEBSITE
  INSTAGRAM
  FACEBOOK
  WHATSAPP
  TIKTOK
  REFERRAL
  MARKETPLACE
  WALK_IN
  EMAIL
  PHONE
  OTHER
}

enum NotificationType {
  SYSTEM
  ALERT
  REMINDER
  UPDATE
  PROMOTION
  TASK
}

enum AutomationTriggerType {
  PRODUCT_CREATED
  PRODUCT_UPDATED
  PRODUCT_SOLD
  ORDER_CREATED
  ORDER_SHIPPED
  ORDER_DELIVERED
  PAYMENT_RECEIVED
  LEAD_CREATED
  LEAD_CONVERTED
  CUSTOMER_CREATED
  INVENTORY_LOW
  AUTHENTICATION_COMPLETED
  SCHEDULED
  WEBHOOK_RECEIVED
}

enum AutomationActionType {
  SEND_EMAIL
  SEND_SMS
  SEND_WHATSAPP
  GENERATE_AI_DESCRIPTION
  GENERATE_AI_SEO
  GENERATE_SOCIAL_CAPTION
  GENERATE_PRICING
  UPDATE_INVENTORY
  CREATE_TASK
  SEND_NOTIFICATION
  POST_TO_SOCIAL
  CREATE_ORDER
  UPDATE_PRODUCT
  CALL_WEBHOOK
  RUN_SCRIPT
  TAG_CUSTOMER
}

enum IntegrationProvider {
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  TIKTOK
  STRIPE
  PAYSTACK
  GOOGLE_DRIVE
  GOOGLE_CALENDAR
  SHOPIFY
  CLOUDINARY
  SLACK
  DISCORD
  NOTION
  AIRTABLE
  SHIPBUBBLE
  DHL
  FEDEX
  EASYSHIP
  ENTRUPY
  LEGIT_APP
}

enum ShippingProvider {
  DHL
  FEDEX
  UPS
  USPS
  SHIPBUBBLE
  EASYSHIP
  OTHER
}

enum ShippingStatus {
  LABEL_CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  EXCEPTION
  RETURNED
}

enum AssetType {
  IMAGE
  VIDEO
  DOCUMENT
  CERTIFICATE
  RECEIPT
  MARKETING
  CONTRACT
  OTHER
}

enum AiAgentType {
  SALES
  CONTENT
  PRICING
  AUTHENTICATION
  MARKETING
  ANALYTICS
  CUSTOM
}

enum AiConversationStatus {
  ACTIVE
  RESOLVED
  ARCHIVED
}

// ============================================================
// TENANT / ORGANIZATION
// ============================================================

model Tenant {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  slug        String       @unique
  domain      String?
  logo        String?
  brandColor  String       @default("#000000")
  accentColor String       @default("#D4AF37")
  status      TenantStatus @default(TRIAL)
  plan        String       @default("starter")
  settings    Json         @default("{}")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  users              User[]
  roles              Role[]
  customRoles        CustomRole[]
  products           Product[]
  customers          Customer[]
  leads              Lead[]
  orders             Order[]
  quotes             Quote[]
  invoices           Invoice[]
  payments           Payment[]
  suppliers          Supplier[]
  campaigns          Campaign[]
  automations        Automation[]
  workflows          AutomationWorkflow[]
  aiConversations    AiConversation[]
  aiAgents           AiAgent[]
  notifications      Notification[]
  activityLogs       ActivityLog[]
  auditLogs          AuditLog[]
  analytics          Analytic[]
  integrations       Integration[]
  assets             Asset[]
  tasks              Task[]
  notes              Note[]
  documents          Document[]
  collections        Collection[]
  categories         Category[]
  brands             Brand[]
  inventoryLogs      InventoryLog[]
  warehouses         Warehouse[]
  certificates       Certificate[]
  authenticationLogs AuthenticationLog[]
  shipments          Shipment[]
  returns            Return[]
  socialPosts        SocialPost[]
  apiKeys            ApiKey[]
  webhooks           Webhook[]

  @@index([slug])
  @@index([status])
  @@map("tenants")
}

// ============================================================
// AUTH & USERS
// ============================================================

model User {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  email          String   @unique
  phone          String?
  firstName      String
  lastName       String
  avatar         String?
  passwordHash   String
  mfaEnabled     Boolean  @default(false)
  mfaSecret      String?
  isActive       Boolean  @default(true)
  lastLoginAt    DateTime?
  preferences    Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleId      String?  @db.Uuid
  customRoleId String? @db.Uuid
  role        Role?    @relation(fields: [roleId], references: [id])
  customRole  CustomRole? @relation(fields: [customRoleId], references: [id])

  assignedTasks   Task[]          @relation("TaskAssignee")
  createdTasks    Task[]          @relation("TaskCreator")
  notes           Note[]
  activityLogs    ActivityLog[]
  orders          Order[]         @relation("OrderSalesRep")
  leads           Lead[]          @relation("LeadOwner")
  conversations   AiConversation[]
  sessions        Session[]

  @@index([tenantId])
  @@index([email])
  @@index([tenantId, roleId])
  @@index([tenantId, customRoleId])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("sessions")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  name        String
  description String?
  permissions Json     @default("[]")
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users  User[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

model CustomRole {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  name        String
  description String?
  permissions Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users  User[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("custom_roles")
}

// ============================================================
// BRANDS
// ============================================================

model Brand {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  name        String   @unique
  slug        String   @unique
  description String?
  logo        String?
  website     String?
  country     String?
  category    String?
  isLuxury    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([tenantId])
  @@index([name])
  @@map("brands")
}

// ============================================================
// CATEGORIES
// ============================================================

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  name        String
  slug        String
  description String?
  parentId    String?  @db.Uuid
  image       String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([parentId])
  @@map("categories")
}

// ============================================================
// COLLECTIONS
// ============================================================

model Collection {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  name        String
  slug        String
  description String?
  image       String?
  isActive    Boolean  @default(true)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("collections")
}

// ============================================================
// PRODUCTS
// ============================================================

model Product {
  id                  String           @id @default(uuid()) @db.Uuid
  tenantId            String           @db.Uuid
  brandId             String           @db.Uuid
  categoryId          String?          @db.Uuid
  collectionId        String?          @db.Uuid

  // Core
  name                String
  slug                String
  sku                 String           @unique
  barcode             String?
  qrCode              String?
  model               String?
  description         String?
  shortDescription    String?
  condition           ProductCondition
  color               String?
  material            String?
  size                String?
  gender              Gender?
  year                Int?
  serialNumber        String?
  style               String?
  season              String?

  // Pricing
  purchasePrice       Decimal          @default(0) @db.Decimal(12, 2)
  shippingCost        Decimal          @default(0) @db.Decimal(12, 2)
  customsCost         Decimal          @default(0) @db.Decimal(12, 2)
  restorationCost     Decimal          @default(0) @db.Decimal(12, 2)
  commission          Decimal          @default(0) @db.Decimal(12, 2)
  totalCost           Decimal          @default(0) @db.Decimal(12, 2)
  sellingPrice        Decimal          @default(0) @db.Decimal(12, 2)
  targetMargin        Decimal          @default(0) @db.Decimal(5, 2)
  profit              Decimal          @default(0) @db.Decimal(12, 2)
  currency            String           @default("USD")
  priceHistory        Json             @default("[]")

  // Status
  status              ProductStatus    @default(DRAFT)
  inventoryStatus     InventoryStatus  @default(AVAILABLE)
  authenticationStatus AuthenticationStatus @default(PENDING)

  // Inventory
  quantity            Int              @default(1)
  reservedQuantity    Int              @default(0)
  location            String?
  warehouseId         String?          @db.Uuid

  // Authentication
  authenticationId    String?          @db.Uuid
  riskScore           Decimal?         @db.Decimal(5, 2)
  isAuthenticated     Boolean          @default(false)
  authenticatedAt     DateTime?
  authenticatedBy     String?

  // Supplier
  supplierId          String?          @db.Uuid
  supplierSku         String?
  purchaseDate        DateTime?
  purchaseDocument    String?

  // SEO
  metaTitle           String?
  metaDescription     String?
  metaKeywords        String?

  // AI
  aiDescription       String?
  aiTags              String[]
  embedding           Unsupported("vector(1536)")?
  lastAiProcessedAt   DateTime?

  // Dimensions & Weight
  weight              Decimal?         @db.Decimal(8, 2)
  length              Decimal?         @db.Decimal(8, 2)
  width               Decimal?         @db.Decimal(8, 2)
  height              Decimal?         @db.Decimal(8, 2)

  // Timestamps
  publishedAt         DateTime?
  soldAt              DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  deletedAt           DateTime?

  // Relations
  tenant              Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brand               Brand            @relation(fields: [brandId], references: [id])
  category            Category?        @relation(fields: [categoryId], references: [id])
  collection          Collection?      @relation(fields: [collectionId], references: [id])
  supplier            Supplier?        @relation(fields: [supplierId], references: [id])

  images              ProductImage[]
  videos              ProductVideo[]
  certificates        Certificate[]
  orderItems          OrderItem[]
  quoteItems          QuoteItem[]
  inventoryLogs       InventoryLog[]
  authenticationLogs  AuthenticationLog[]
  tasks               Task[]
  leadItems           LeadItem[]
  wishlistItems       WishlistItem[]
  notes               Note[]

  @@index([tenantId])
  @@index([brandId])
  @@index([categoryId])
  @@index([sku])
  @@index([status])
  @@index([inventoryStatus])
  @@index([authenticationStatus])
  @@index([tenantId, status])
  @@index([tenantId, brandId])
  @@index([tenantId, inventoryStatus])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  url       String
  alt       String?
  width     Int?
  height    Int?
  size      Int?
  format    String?
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([productId, isPrimary])
  @@map("product_images")
}

model ProductVideo {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  url       String
  title     String?
  duration  Int?
  size      Int?
  format    String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_videos")
}

// ============================================================
// INVENTORY
// ============================================================

model InventoryLog {
  id              String          @id @default(uuid()) @db.Uuid
  productId       String          @db.Uuid
  tenantId        String          @db.Uuid
  previousStatus  InventoryStatus?
  newStatus       InventoryStatus
  previousQty     Int?
  newQty          Int
  changedBy       String          @db.Uuid
  reason          String?
  reference       String?
  referenceId     String?
  createdAt       DateTime        @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([tenantId])
  @@index([createdAt])
  @@map("inventory_logs")
}

model Warehouse {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  name        String
  address     String?
  city        String?
  country     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("warehouses")
}

// ============================================================
// CRM
// ============================================================

model Customer {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  email         String?
  phone         String?
  firstName     String
  lastName      String
  avatar        String?
  company       String?
  tags          String[]
  isVip         Boolean  @default(false)
  source        LeadSource?
  notesText     String?
  totalSpent    Decimal  @default(0) @db.Decimal(12, 2)
  totalOrders   Int      @default(0)
  lifetimeValue Decimal  @default(0) @db.Decimal(12, 2)
  lastPurchaseAt DateTime?
  preferences   Json     @default("{}")
  address       Json?
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders        Order[]
  leads         Lead[]
  quotes        Quote[]
  invoices      Invoice[]
  wishlist      WishlistItem[]
  tasks         Task[]
  notes         Note[]
  conversations AiConversation[]

  @@index([tenantId])
  @@index([email])
  @@index([phone])
  @@index([tenantId, isVip])
  @@index([tenantId, totalSpent])
  @@map("customers")
}

model WishlistItem {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  productId  String   @db.Uuid
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@index([customerId])
  @@map("wishlist_items")
}

model Lead {
  id            String     @id @default(uuid()) @db.Uuid
  tenantId      String     @db.Uuid
  customerId    String?    @db.Uuid
  ownerId       String?    @db.Uuid
  email         String?
  phone         String?
  firstName     String
  lastName      String
  company       String?
  source        LeadSource @default(OTHER)
  status        LeadStatus @default(NEW)
  score         Int        @default(0)
  tags          String[]
  notesText     String?
  budget        Decimal?   @db.Decimal(12, 2)
  convertedAt   DateTime?
  convertedToCustomerId String? @db.Uuid
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer? @relation(fields: [customerId], references: [id])
  owner      User?     @relation("LeadOwner", fields: [ownerId], references: [id])
  items      LeadItem[]
  tasks      Task[]
  notes      Note[]
  quotes     Quote[]
  orders     Order[]

  @@index([tenantId])
  @@index([ownerId])
  @@index([status])
  @@index([source])
  @@index([tenantId, status])
  @@map("leads")
}

model LeadItem {
  id        String @id @default(uuid()) @db.Uuid
  leadId    String @db.Uuid
  productId String @db.Uuid
  quantity  Int    @default(1)

  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([leadId])
  @@map("lead_items")
}

// ============================================================
// SALES
// ============================================================

model Quote {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  leadId     String?  @db.Uuid
  customerId String?  @db.Uuid
  quoteNumber String  @unique
  subtotal   Decimal  @default(0) @db.Decimal(12, 2)
  discount   Decimal  @default(0) @db.Decimal(12, 2)
  tax        Decimal  @default(0) @db.Decimal(12, 2)
  total      Decimal  @default(0) @db.Decimal(12, 2)
  currency   String   @default("USD")
  status     String   @default("DRAFT")
  validUntil DateTime?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead     Lead?     @relation(fields: [leadId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  items    QuoteItem[]
  order    Order?

  @@index([tenantId])
  @@index([leadId])
  @@index([quoteNumber])
  @@map("quotes")
}

model QuoteItem {
  id        String  @id @default(uuid()) @db.Uuid
  quoteId   String  @db.Uuid
  productId String? @db.Uuid
  name      String
  quantity  Int     @default(1)
  unitPrice Decimal @default(0) @db.Decimal(12, 2)
  total     Decimal @default(0) @db.Decimal(12, 2)

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([quoteId])
  @@map("quote_items")
}

model Order {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @db.Uuid
  customerId    String?     @db.Uuid
  leadId        String?     @db.Uuid
  quoteId       String?     @unique @db.Uuid
  salesRepId    String?     @db.Uuid
  orderNumber   String      @unique
  status        OrderStatus @default(PENDING)
  subtotal      Decimal     @default(0) @db.Decimal(12, 2)
  discount      Decimal     @default(0) @db.Decimal(12, 2)
  tax           Decimal     @default(0) @db.Decimal(12, 2)
  shippingCost  Decimal     @default(0) @db.Decimal(12, 2)
  total         Decimal     @default(0) @db.Decimal(12, 2)
  profit        Decimal     @default(0) @db.Decimal(12, 2)
  currency      String      @default("USD")
  notes         String?
  tags          String[]
  paidAt        DateTime?
  shippedAt     DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer?   @relation(fields: [customerId], references: [id])
  lead        Lead?       @relation(fields: [leadId], references: [id])
  quote       Quote?      @relation(fields: [quoteId], references: [id])
  salesRep    User?       @relation("OrderSalesRep", fields: [salesRepId], references: [id])
  items       OrderItem[]
  payments    Payment[]
  invoices    Invoice[]
  shipments   Shipment[]
  returns     Return[]

  @@index([tenantId])
  @@index([customerId])
  @@index([status])
  @@index([orderNumber])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @db.Uuid
  productId String? @db.Uuid
  name      String
  sku       String?
  quantity  Int     @default(1)
  unitPrice Decimal @default(0) @db.Decimal(12, 2)
  discount  Decimal @default(0) @db.Decimal(12, 2)
  total     Decimal @default(0) @db.Decimal(12, 2)
  cost      Decimal @default(0) @db.Decimal(12, 2)
  profit    Decimal @default(0) @db.Decimal(12, 2)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

// ============================================================
// INVOICES & PAYMENTS
// ============================================================

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @db.Uuid
  orderId       String?       @db.Uuid
  customerId    String?       @db.Uuid
  invoiceNumber String        @unique
  subtotal      Decimal       @default(0) @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  tax           Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @default(0) @db.Decimal(12, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(12, 2)
  amountDue     Decimal       @default(0) @db.Decimal(12, 2)
  currency      String        @default("USD")
  status        PaymentStatus @default(PENDING)
  dueDate       DateTime?
  paidAt        DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order    Order?    @relation(fields: [orderId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  payments Payment[]

  @@index([tenantId])
  @@index([orderId])
  @@index([invoiceNumber])
  @@map("invoices")
}

model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @db.Uuid
  orderId       String?       @db.Uuid
  invoiceId     String?       @db.Uuid
  amount        Decimal       @default(0) @db.Decimal(12, 2)
  currency      String        @default("USD")
  method        String
  provider      String?
  transactionId String?
  status        PaymentStatus @default(PENDING)
  notes         String?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order   Order?   @relation(fields: [orderId], references: [id])
  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([tenantId])
  @@index([orderId])
  @@index([transactionId])
  @@map("payments")
}

