// ============================================================
// SUPPLIERS
// ============================================================

model Supplier {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  name            String
  contactName     String?
  email           String?
  phone           String?
  website         String?
  address         String?
  city            String?
  country         String?
  tags            String[]
  reliabilityScore Decimal? @db.Decimal(5, 2)
  avgShippingDays Int?
  notes           String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

