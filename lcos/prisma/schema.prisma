// ============================================================
// SHIPPING
// ============================================================

model Shipment {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @db.Uuid
  orderId         String          @db.Uuid
  provider        ShippingProvider
  trackingNumber  String?
  trackingUrl     String?
  status          ShippingStatus  @default(LABEL_CREATED)
  estimatedDelivery DateTime?
  deliveredAt     DateTime?
  weight          Decimal?        @db.Decimal(8, 2)
  dimensions      String?
  cost            Decimal?        @db.Decimal(12, 2)
  insurance       Decimal?        @db.Decimal(12, 2)
  originAddress   Json?
  destinationAddress Json?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id])

  @@index([tenantId])
  @@index([orderId])
  @@index([trackingNumber])
  @@map("shipments")
}

// ============================================================
// RETURNS
// ============================================================

model Return {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  orderId     String   @db.Uuid
  reason      String
  status      String   @default("REQUESTED")
  condition   String?
  refundAmount Decimal? @db.Decimal(12, 2)
  notes       String?
  approvedAt  DateTime?
  receivedAt  DateTime?
  refundedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id])

  @@index([tenantId])
  @@index([orderId])
  @@map("returns")
}

// ============================================================
// MARKETING
// ============================================================

model Campaign {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  name        String
  description String?
  type        String
  platform    String?
  status      String   @default("DRAFT")
  budget      Decimal? @db.Decimal(12, 2)
  spent       Decimal? @db.Decimal(12, 2)
  startDate   DateTime?
  endDate     DateTime?
  tags        String[]
  metrics     Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  socialPosts  SocialPost[]

  @@index([tenantId])
  @@index([status])
  @@map("campaigns")
}

model SocialPost {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  campaignId String?  @db.Uuid
  productId  String?  @db.Uuid
  platform   String
  content    String
  mediaUrls  String[]
  hashtags   String[]
  status     String   @default("DRAFT")
  scheduledAt DateTime?
  postedAt   DateTime?
  url        String?
  metrics    Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id])

  @@index([tenantId])
  @@index([campaignId])
  @@index([platform])
  @@index([status])
  @@map("social_posts")
}

// ============================================================
// AI
// ============================================================

model AiAgent {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @db.Uuid
  name        String
  type        AiAgentType
  description String?
  model       String      @default("gpt-4o")
  instructions Json       @default("{}")
  isActive    Boolean     @default(true)
  config      Json        @default("{}")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations AiConversation[]

  @@index([tenantId])
  @@index([type])
  @@map("ai_agents")
}

model AiConversation {
  id         String              @id @default(uuid()) @db.Uuid
  tenantId   String              @db.Uuid
  agentId    String?             @db.Uuid
  userId     String?             @db.Uuid
  customerId String?             @db.Uuid
  title      String?
  status     AiConversationStatus @default(ACTIVE)
  metadata   Json                @default("{}")
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent    AiAgent?  @relation(fields: [agentId], references: [id])
  user     User?     @relation(fields: [userId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  messages AiMessage[]

  @@index([tenantId])
  @@index([agentId])
  @@index([userId])
  @@index([customerId])
  @@map("ai_conversations")
}

model AiMessage {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @db.Uuid
  role           String
  content        String
  metadata       Json     @default("{}")
  tokens         Int?
  model          String?
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_messages")
}

// ============================================================
// AUTOMATION
// ============================================================

model Automation {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rules   AutomationRule[]

  @@index([tenantId])
  @@map("automations")
}

model AutomationRule {
  id            String   @id @default(uuid()) @db.Uuid
  automationId  String   @db.Uuid
  triggerType   AutomationTriggerType
  triggerConfig Json     @default("{}")
  actionType    AutomationActionType
  actionConfig  Json     @default("{}")
  conditions    Json     @default("{}")
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
  @@map("automation_rules")
}

model AutomationWorkflow {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  name        String
  description String?
  definition  Json
  isActive    Boolean  @default(true)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("automation_workflows")
}

// ============================================================
// ASSETS
// ============================================================

model Asset {
