        "MEMORY_FILE_PATH": "C:\\Users\\1040 G8\\Documents\\jarvis-demo\\.claude\\memory.jsonl"
      }
    },
    "cortex": {
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "cortex-mcp-server"],
