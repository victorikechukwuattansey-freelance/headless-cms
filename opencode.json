    "playwright": {
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "@playwright/mcp"],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": true,
      "env": {
        "GITHUB_TOKEN": "{env:GITHUB_TOKEN}"
      }
    },
    "sqlite": {
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "@modelcontextprotocol/server-sqlite", ".claude/db.sqlite"],
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "@modelcontextprotocol/server-filesystem", "C:\\Users\\1040 G8\\Documents", "C:\\Users\\1040 G8\\Documents\\jarvis-demo\\_open-canva"],
      "enabled": true
    },
    "social": {
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "@posteverywhere/mcp"],
      "enabled": true,
      "env": {
        "POSTEVERYWHERE_API_KEY": "{env:POSTEVERYWHERE_API_KEY}"
      }
    },
    "affinity-designer": {
      "type": "local",
      "command": ["cmd", "/c", "C:\\Users\\1040G8~1\\DOCUME~1\\JARVIS~1\\_MCP-A~1\\node_modules\\.bin\\tsx.cmd", "C:\\Users\\1040G8~1\\DOCUME~1\\JARVIS~1\\_MCP-A~1\\src\\index.ts"],
      "enabled": true
    },
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp",
      "enabled": true,
      "timeout": 30000,
      "headers": {
        "Figma-Token": "{env:FIGMA_TOKEN}"
      }
    },
    "oxylabs": {
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "@oxylabs/oxylabs-mcp"],
