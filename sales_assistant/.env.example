DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/sales_assistant?schema=public
# Separate database for runtime integration tests (ephemeral, truncated per run)
TEST_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:55432/sales_assistant_test?schema=public
REDIS_URL=redis://localhost:56379
PORT=3000
JWT_SECRET=change-me-min-32-chars-required-in-production
INTEGRATION_TOKEN_ENCRYPTION_KEY=change-me-min-32-chars-required-in-production
OPENAI_API_KEY=
# Rate limiting (requests per window per user/IP)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
# Metrics endpoint: unset allows anonymous access in dev only; set a strong token to require Bearer auth
METRICS_TOKEN=
# Set to true ONLY when running behind a trusted reverse proxy that overwrites X-Forwarded-For
TRUST_PROXY=false
# Max request body size in bytes
MAX_BODY_BYTES=1048576
# Follow-up reminders
FOLLOW_UP_THRESHOLD_DAYS=7
FOLLOW_UP_DUE_HOURS=24
# Web dashboard (apps/web)
API_URL=http://localhost:3000
