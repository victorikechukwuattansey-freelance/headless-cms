{
  "name": "sales-assistant",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.18.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run build",
    "test": "npm run test:repo && npm --workspace @sales_assistant/api run test && npm --workspace @sales_assistant/api-client run test && npm --workspace @sales_assistant/via run test",
    "test:repo": "node --test \"tests/*.test.mjs\"",
    "test:integration": "npm --workspace @sales_assistant/api run test:integration",
    "db:generate": "npm --workspace @sales_assistant/api run db:generate",
    "db:migrate": "npm --workspace @sales_assistant/api run db:migrate",
    "db:migrate:deploy": "npm --workspace @sales_assistant/api run db:migrate:deploy",
    "db:seed": "npm --workspace @sales_assistant/api run db:seed",
    "dev:web": "npm --workspace @sales_assistant/web run dev",
    "build:web": "npm --workspace @sales_assistant/web run build"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  },
  "allowScripts": {
    "prisma@5.22.0": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.28.2": true
  }
}
