      "id": "a1000001-0001-0001-0001-000000000011",
      "name": "Google Places API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [2200, 0],
      "credentials": {}
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": ""
          },
          "conditions": [
            {
              "id": "cond-api-01",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 200,
              "operator": {
