      "id": "a1000001-0001-0001-0001-000000000012",
      "name": "API Success?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2420, 0]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst response = $input.first().json;\nconst searchInput = $('Build API Query').first().json;\n\nconst body = response.body || response;\nconst places = body.places || [];\nconst maxResults = staticData.MAX_RESULTS_PER_SEARCH || 20;\nconst targetCount = Number(searchInput.target_count) || 1;\nconst effectiveLimit = Math.min(targetCount, maxResults);\n\nconst leads = [];\nconst seenKeys = new Set();\n\nconst limitedPlaces = places.slice(0, effectiveLimit);\n\nfor (const place of limitedPlaces) {\n  const rawAddress = place.formattedAddress || '';\n  const addressParts = rawAddress.split(',').map(s => s.trim());\n\n  const displayName = place.displayName || {};\n  const businessName = (displayName.text || '').trim();\n  const phone = (place.internationalPhoneNumber || place.nationalPhoneNumber || '').replace(/[^\\d+]/g, '');\n  const websiteRaw = (place.websiteUri || '').toLowerCase().trim()\n    .replace(/^https?:\\/\\//, '')\n    .replace(/www\\./, '')\n    .replace(/\\/+$/, '');\n  const website = websiteRaw ? 'https://' + websiteRaw : '';\n  const rating = Number(place.rating) || 0;\n  const reviewCount = Number(place.userRatingCount) || 0;\n  const businessType = (place.types || []).join(', ');\n  const mapsUrl = place.googleMapsUri || '';\n\n  let dedupeKey = '';\n  if (websiteRaw) {\n    dedupeKey = 'website:' + websiteRaw;\n  } else if (phone) {\n    dedupeKey = 'phone:' + phone;\n  } else {\n    dedupeKey = 'ncs:' + [\n      businessName.toLowerCase(),\n      (searchInput.city || '').toLowerCase(),\n      (searchInput.state || '').toLowerCase()\n    ].join('|');\n  }\n\n  if (seenKeys.has(dedupeKey)) continue;\n  seenKeys.add(dedupeKey);\n\n  const ts = Date.now().toString(36).toUpperCase();\n  const rnd = Math.random().toString(36).substr(2, 5).toUpperCase();\n  const leadId = 'LD-' + ts + '-' + rnd;\n\n  let city = searchInput.city || '';\n  let state = searchInput.state || '';\n  if (!city && addressParts.length >= 3) city = addressParts[addressParts.length - 3];\n  if (!state && addressParts.length >= 2) {\n    const sm = addressParts[addressParts.length - 2].match(/^([A-Z]{2})/);\n    if (sm) state = sm[1];\n  }\n\n  leads.push({\n    json: {\n      lead_id: leadId,\n      business_name: businessName,\n      niche: searchInput.niche || '',\n      city: city,\n      state: state,\n      country: searchInput.country || 'US',\n      address: rawAddress,\n      phone: phone,\n      website: website,\n      rating: rating,\n      review_count: reviewCount,\n      google_maps_url: mapsUrl,\n      business_type: businessType,\n      source: 'Google Places',\n      search_input_id: searchInput.input_id || '',\n      dedupe_key: dedupeKey,\n      raw_captured_at: new Date().toISOString(),\n      notes: ''\n    }\n  });\n}\n\nstaticData.leadsCaptured = (staticData.leadsCaptured || 0) + leads.length;\n\nif (leads.length === 0) {\n  return [{\n    json: {\n      _noResults: true,\n      _searchInputId: searchInput.input_id || '',\n      _message: places.length > 0 ? 'All results were in-batch duplicates' : 'No businesses returned by API'\n    }\n  }];\n}\n\nreturn leads;"
      },
