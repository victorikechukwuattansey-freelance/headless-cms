    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst items = $input.all();\nconst dedupKeys = [];\n\nfor (const item of items) {\n  const lead = item.json;\n  let key = '';\n\n  if (lead.website) {\n    key = 'website:' + String(lead.website).toLowerCase().trim()\n      .replace(/^https?:\\/\\//, '')\n      .replace(/www\\./, '')\n      .replace(/\\/+$/, '');\n  } else if (lead.phone) {\n    key = 'phone:' + String(lead.phone).replace(/[^\\d+]/g, '');\n  } else if (lead.business_name && lead.city && lead.state) {\n    key = 'ncs:' + [\n      String(lead.business_name).toLowerCase().trim(),\n      String(lead.city).toLowerCase().trim(),\n      String(lead.state).toLowerCase().trim()\n    ].join('|');\n  }\n\n  if (key) dedupKeys.push(key);\n}\n\nstaticData.verifiedDedupKeys = [...new Set(dedupKeys)];\nstaticData.verifiedLeadCount = dedupKeys.length;\nreturn $input.all();"
      },
