    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nconst pending = [];\n\nfor (const item of items) {\n  const status = String(item.json.status || '').trim();\n  if (status === 'Pending' || status === '') {\n    pending.push(item);\n  }\n}\n\nif (pending.length === 0) {\n  return [{ json: { _noPending: true, _message: 'All searches completed or failed' } }];\n}\n\nreturn pending;"
      },
