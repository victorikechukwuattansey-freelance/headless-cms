    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst searchInput = $('Loop Through Searches').first().json;\n\nconst maxResults = staticData.MAX_RESULTS_PER_SEARCH || 20;\n\nlet query = String(searchInput.search_query || '').trim();\nif (!query) {\n  query = String(searchInput.niche || '');\n  if (searchInput.city) query += ' in ' + searchInput.city;\n  if (searchInput.state) query += ', ' + searchInput.state;\n}\n\nconst fieldMask =\n  'places.displayName.text,places.formattedAddress,places.internationalPhoneNumber,places.websiteUri,places.rating,places.userRatingCount,places.types,places.googleMapsUri';\n\nreturn [{\n  json: {\n    ...searchInput,\n    _apiQuery: query,\n    _maxResults: maxResults,\n    _fieldMask: fieldMask\n  }\n}];"
      },
