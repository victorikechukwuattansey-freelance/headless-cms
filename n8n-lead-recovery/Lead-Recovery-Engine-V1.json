    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst response = $input.first().json;\nconst searchInput = $('Build API Query').first().json;\n\nconst statusCode = response.statusCode || 0;\nconst body = response.body || response;\nconst error = body.error || {};\nconst errorMsg = error.message\n  || error.status\n  || 'HTTP error ' + statusCode\n  || 'Unknown API error';\n\nstaticData.errorsEncountered = (staticData.errorsEncountered || 0) + 1;\n\nreturn [{\n  json: {\n    input_id: searchInput.input_id || '',\n    _errorMessage: 'Places API error: ' + errorMsg + ' (HTTP ' + statusCode + ')',\n    _rawStatus: error.status || ('HTTP ' + statusCode)\n  }\n}];"
