    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst items = $input.all();\nconst existingKeys = new Set(staticData.verifiedDedupKeys || []);\nconst verified = [];\n\nfor (const item of items) {\n  const lead = item.json;\n  const key = lead.dedupe_key || '';\n\n  if (existingKeys.has(key)) continue;\n  existingKeys.add(key);\n\n  verified.push({\n    json: {\n      lead_id: lead.lead_id,\n      business_name: lead.business_name,\n      niche: lead.niche,\n      city: lead.city,\n      state: lead.state,\n      country: lead.country,\n      address: lead.address,\n      phone: lead.phone,\n      website: lead.website,\n      rating: lead.rating,\n      review_count: lead.review_count,\n      google_maps_url: lead.google_maps_url,\n      business_type: lead.business_type,\n      source: lead.source,\n      search_input_id: lead.search_input_id,\n      verified_at: new Date().toISOString(),\n      manual_review_notes: ''\n    }\n  });\n}\n\nstaticData.verifiedDedupKeys = [...existingKeys];\nstaticData.leadsVerified = (staticData.leadsVerified || 0) + verified.length;\n\nif (verified.length === 0) {\n  return [{\n    json: {\n      _noNewVerified: true,\n      _searchInputId: items[0]?.json?.search_input_id || '',\n      _message: 'All leads already exist in Verified Leads'\n    }\n  }];\n}\n\nreturn verified;"
      },
