# Google Sheets Verification & Fixture Harness v0.1 — env placeholders only.
# Never commit real credentials. Copy to .env and fill in locally, or export
# these as environment variables / set them via run-live-tests.ps1 prompts.

# Spreadsheet the Approved Outreach Handoff V1 workflow writes to (production).
# Required for live verification runs.
GOOGLE_SHEET_ID=REPLACE_WITH_SPREADSHEET_ID

# Optional: dedicated fixture spreadsheet (isolated from production). Seeding in
# "plain" mode (which writes formula-owned Q:U columns) must target this sheet.
FIXTURE_SHEET_ID=

# Google auth — provide ONE of the following:
# 1) Short-lived OAuth access token:
GOOGLE_ACCESS_TOKEN=
# 2) Service account JSON file path (harness mints + exchanges a JWT):
GOOGLE_SERVICE_ACCOUNT_JSON=

# n8n execution backend (Response Interpretation V1 live runner, Phase 5 revision).
# The Community edition public API cannot trigger executions for manual-trigger
# workflows, so the runner executes the workflow from the n8n CLI inside the
# running container. Select the backend with RESP_INT_EXEC_BACKEND=cli|http
# (cli is the default).
RESP_INT_EXEC_BACKEND=cli

# CLI mode — docker exec `n8n execute --id <workflow>` inside the running n8n
# container (must be the same container that holds the n8n server + SQLite DB).
RESP_INT_EXEC_CONTAINER=serene_swartz

# CLI mode — port for the n8n CLI's TEMPORARY task broker during `n8n execute`.
# CRITICAL: this MUST differ from the running server's broker port 5679 (the
# runner rejects 5679). The shipped default 5677 is safe.
RESP_INT_EXEC_BROKER_PORT=5677

# HTTP mode (fallback) — for n8n instances that expose a run endpoint. When
# these are absent and backend=http is selected the harness prints MANUAL steps
# instead of claiming a live pass; never a fabricated PASS.
N8N_BASE_URL=
N8N_API_KEY=
N8N_WORKFLOW_ID=

# Response Interpretation V1 live runner (Phase 5):
# -------------------------------------------------------------------------
# Target spreadsheet must be the pinned engine spreadsheet (SPREADSHEET_ID in
# src/response-interpretation-workflow-contract.js) unless --allow-non-pinned-sheet
# is passed (that mode is NOT live-equivalent to the engine sheet). The tab is
# always the canonical "Response Log".
GOOGLE_SHEET_ID=REPLACE_WITH_SPREADSHEET_ID # <-- must equal the pinned engine sheet for live runs

# Optional deterministic namespace tag (hex, 8-32 chars) for the Phase 5
# TEST-RESP-INT-LIVE-<tag> namespace. Defaults to a runtime hex time tag.
RESP_INT_LIVE_RUN_TOKEN=