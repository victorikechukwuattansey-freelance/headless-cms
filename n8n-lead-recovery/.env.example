# Google Sheets Verification & Fixture Harness v0.1 — env placeholders only.
# Never commit real credentials. Copy to .env and fill in locally, or export
# these as environment variables / set them via run-live-tests.ps1 prompts.

# Spreadsheet the Approved Outreach Handoff V1 workflow writes to (production).
# Required for live verification runs.
GOOGLE_SHEET_ID=REPLACE_WITH_SPREADSHEET_ID

# Optional: dedicated fixture spreadsheet (isolated from production). Seeding in
# "plain" mode (which writes formula-owned Q:U columns) must target this sheet.
FIXTURE_SHEET_ID=

# Google auth — provide ONE of the following:
# 1) Short-lived OAuth access token:
GOOGLE_ACCESS_TOKEN=
# 2) Service account JSON file path (harness mints + exchanges a JWT):
GOOGLE_SERVICE_ACCOUNT_JSON=

# n8n execution backend (Response Interpretation V1 live runner, Phase 5 + 6.5).
# The Community edition public API cannot trigger executions for manual-trigger
# workflows, so the runner executes the workflow from the n8n CLI inside the
# running container (cli), or against a running n8n instance via the REST API
# (http), or through the Phase 6.5 test-only webhook harness (harness) that
# injects a scenario payload into the frozen chain. Select the backend with
# RESP_INT_EXEC_BACKEND=cli|http|harness (cli is the default). --inject-scenario
# forces the harness backend for a single run.
RESP_INT_EXEC_BACKEND=cli

# CLI mode — docker exec `n8n execute --id <workflow>` inside the running n8n
# container (must be the same container that holds the n8n server + SQLite DB).
RESP_INT_EXEC_CONTAINER=serene_swartz

# CLI mode — port for the n8n CLI's TEMPORARY task broker during `n8n execute`.
# CRITICAL: this MUST differ from the running server's broker port 5679 (the
# runner rejects 5679). The shipped default 5677 is safe.
RESP_INT_EXEC_BROKER_PORT=5677

# HTTP mode (fallback) — for n8n instances that expose a run endpoint. When
# these are absent and backend=http is selected the harness prints MANUAL steps
# instead of claiming a live pass; never a fabricated PASS.
N8N_BASE_URL=
N8N_API_KEY=
N8N_WORKFLOW_ID=

# HARNESS mode (Phase 6.5, test-only) — webhook payload injection against the
# generated "Response-Interpretation V1 — Test Harness" workflow. Google Sheets
# credential access is resolved by the running n8n instance; the webhook is
# unauthenticated (no API key required). Build the harness artifact first:
#   node scripts/build-response-interpretation-test-harness.js
# If the harness artifact is missing or unregistered the phase-6.5 comparison
# reports NOT_CONFIGURED with MANUAL steps — never a fabricated PASS.
# RESP_INT_HARNESS_WORKFLOW_ID is REQUIRED and is never derived from
# N8N_WORKFLOW_ID (the production id must not leak into the test surface); when
# it is unset the harness backend reports NOT_CONFIGURED.
RESP_INT_HARNESS_BASE_URL=            # fallback: N8N_BASE_URL
RESP_INT_HARNESS_WORKFLOW_ID=         # REQUIRED: harnessRespIntV10000001
RESP_INT_HARNESS_WEBHOOK_PATH=        # optional; default: test/resp-int-harness
RESP_INT_HARNESS_WEBHOOK_MODE=        # optional; default: production (use "test" for one-shot webhook-test)

# Google Places API (New) — restricted to Places API, billing enabled
GOOGLE_PLACES_API_KEY=

# Enrichment V1 (provider contact pass; see docs/OPEN-SOURCE-ENRICHMENT.md and
# docs/AGENTDATA-API.md). Read by the live runner only and injected as provider
# seams at execution time — these are NEVER embedded in the shipped
# Enrichment V1.json workflow.
ENRICHMENT_PROVIDER=agentdata  # default contact-enrichment provider; set "hunter" to reactivate the legacy provider
AGENTDATA_API_KEY=             # AgentData domain-search credentials (default provider; Bearer auth)
HUNTER_API_KEY=                # Hunter.io domain-search credentials (only when ENRICHMENT_PROVIDER=hunter)
HUNTER_TRANSPORT=cli           # autocomplete page accepts: cli | rest

# Country policy for the enrichment contact pass (H.8c / D-C8, runner-only).
# ENRICHMENT_COUNTRIES_ALLOW: comma-separated ISO-3166 alpha-2 codes
# (e.g. "US,CA,GB"); default "US"; "*"/empty = allow all. Matching is exact
# alpha-2 only (no aliasing). ENRICHMENT_COUNTRIES_DENY: deny list, wins over
# allow. Missing/blank country fails closed. The shipped workflow and engines
# keep the frozen US-only isUsCountry default when no policy is injected.
ENRICHMENT_COUNTRIES_ALLOW=US
ENRICHMENT_COUNTRIES_DENY=

# Business Enrichment V1 (H.9) — engine-direct live runner
# (scripts/run-business-enrichment-live.js). The business identity index is
# built from a local Overture Places parquet file (default
# fixtures/overture-austin.parquet). Set to override the path; the value may
# also be passed with --overture=<path>.
OVERTURE_PARQUET_PATH=

# H.9.1 — production-write confirmation for the engine-direct live runner.
# The runner refuses --execute --scope=production unless this is exactly "1"
# (two independent acknowledgments: the flag plus this env var). It is NEVER
# consulted in DRY_RUN mode and is not required for the default test scope.
# Leave unset for test-scope runs.
BIZ_ENRICH_ALLOW_PRODUCTION=

# Response Interpretation V1 live runner (Phase 5):
# -------------------------------------------------------------------------
# Target spreadsheet must be the pinned engine spreadsheet (SPREADSHEET_ID in
# src/response-interpretation-workflow-contract.js) unless --allow-non-pinned-sheet
# is passed (that mode is NOT live-equivalent to the engine sheet). The tab is
# always the canonical "Response Log".
GOOGLE_SHEET_ID=REPLACE_WITH_SPREADSHEET_ID # <-- must equal the pinned engine sheet for live runs
# GOOGLE_SHEET_ID may also be the full https://docs.google.com/spreadsheets/d/<id>/... URL; the
# Sheets client extracts the bare id (primarily for --allow-non-pinned-sheet runs).

# Optional deterministic namespace tag (hex, 8-32 chars) for the Phase 5
# TEST-RESP-INT-LIVE-<tag> namespace. Defaults to a runtime hex time tag.
RESP_INT_LIVE_RUN_TOKEN=

# Resend real-email delivery (Outreach Execution & Delivery V1, Doc 1D):
# -------------------------------------------------------------------------
# RFC 8058 one-click unsubscribe. Strongly recommended for cold outreach.
# URL: an HTTPS endpoint that accepts POST and removes the recipient.
# MAILTO: a mailbox a human monitors; replies must be honored.
# Either can be set alone. Both is preferred — Gmail's bulk-sender rules
# treat One-Click (URL + Post header) as a deliverability signal.
# Canonical: https://www.viaaiautomation.work.gd/unsubscribe
# The apex (viaaiautomation.work.gd) is not served by the Pages project;
# use the www. host in RESEND_UNSUBSCRIBE_URL.
RESEND_UNSUBSCRIBE_URL=
RESEND_UNSUBSCRIBE_MAILTO=