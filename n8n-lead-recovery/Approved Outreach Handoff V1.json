                      "id":  "1f3a5c2e-9b4d-4f1a-8c9a-5d0e2b3a7f02",
                      "name":  "Read Verified Leads",
                      "type":  "n8n-nodes-base.googleSheets",
                      "typeVersion":  4,
                      "position":  [
                                       220,
                                       0
                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const items = $input.all();\n\nconst counters = {\n  verified_examined: items.length,\n  eligible: 0,\n  ineligible_not_qualified: 0,\n  ineligible_missing_business_name: 0,\n  ineligible_missing_city: 0,\n  ineligible_missing_state: 0,\n  ineligible_missing_country: 0,\n  ineligible_no_contact_path: 0\n};\n\nconst eligible = [];\n\nfor (const item of items) {\n  const lead = item.json || {};\n\n  const businessName = String(lead.business_name || \u0027\u0027).trim();\n  const city = String(lead.city || \u0027\u0027).trim();\n  const state = String(lead.state || \u0027\u0027).trim();\n  const country = String(lead.country || \u0027\u0027).trim();\n  const hasWebsite = String(lead.website || \u0027\u0027).trim() !== \u0027\u0027;\n  const hasPhone = String(lead.phone || \u0027\u0027).trim() !== \u0027\u0027;\n  const hasContactPath = hasWebsite || hasPhone;\n  const isQualified = String(lead.qualification_status || \u0027\u0027).trim().toUpperCase() === \u0027QUALIFIED\u0027;\n\n  if (!isQualified) {\n    counters.ineligible_not_qualified += 1;\n    continue;\n  }\n  if (!businessName) {\n    counters.ineligible_missing_business_name += 1;\n    continue;\n  }\n  if (!city) {\n    counters.ineligible_missing_city += 1;\n    continue;\n  }\n  if (!state) {\n    counters.ineligible_missing_state += 1;\n    continue;\n  }\n  if (!country) {\n    counters.ineligible_missing_country += 1;\n    continue;\n  }\n  if (!hasContactPath) {\n    counters.ineligible_no_contact_path += 1;\n    continue;\n  }\n\n  eligible.push(item);\n  counters.eligible += 1;\n}\n\nif (eligible.length === 0) {\n  return [{\n    json: {\n      _noNewApproved: true,\n      _message: \u0027No new eligible leads for Approved Outreach\u0027,\n      _control: counters\n    }\n  }];\n}\n\nreturn eligible.map((item) =\u003e ({\n  json: Object.assign({}, item.json, { _control: counters })\n}));"
                                     },
