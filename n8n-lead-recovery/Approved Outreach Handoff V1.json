                      "id":  "1f3a5c2e-9b4d-4f1a-8c9a-5d0e2b3a7f04",
                      "name":  "Read Approved Outreach",
                      "type":  "n8n-nodes-base.googleSheets",
                      "typeVersion":  4,
                      "position":  [
                                       660,
                                       0
                                   ],
                      "alwaysOutputData":  true
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const approvedItems = $input.all();\nconst eligibleItems = $(\u0027Filter Eligible Leads\u0027).all();\n\nconst filterCounters = {};\nfor (const item of eligibleItems) {\n  const control = (item.json || {})._control;\n  if (control \u0026\u0026 typeof control === \u0027object\u0027) Object.assign(filterCounters, control);\n}\n\nconst existingIds = new Set();\nfor (const item of approvedItems) {\n  const id = String((item.json || {}).lead_id || \u0027\u0027).trim();\n  if (id) existingIds.add(id);\n}\n\nconst eligible = eligibleItems.filter((item) =\u003e !((item.json || {})._noNewApproved === true));\n\nconst counters = {\n  eligible_incoming: eligible.length,\n  already_approved: 0,\n  duplicate_in_batch: 0,\n  newly_approved: 0\n};\n\nif (eligible.length === 0) {\n  return [{\n    json: {\n      _noNewApproved: true,\n      _message: \u0027No new eligible leads for Approved Outreach\u0027,\n      _control: Object.assign({}, filterCounters, counters)\n    }\n  }];\n}\n\nconst seenThisRun = new Set();\nconst newRows = [];\n\nfor (const item of eligible) {\n  const lead = item.json || {};\n  const leadId = String(lead.lead_id || \u0027\u0027).trim();\n\n  if (!leadId) {\n    counters.duplicate_in_batch += 1;\n    continue;\n  }\n  if (existingIds.has(leadId)) {\n    counters.already_approved += 1;\n    continue;\n  }\n  if (seenThisRun.has(leadId)) {\n    counters.duplicate_in_batch += 1;\n    continue;\n  }\n\n  seenThisRun.add(leadId);\n  newRows.push(item);\n  counters.newly_approved += 1;\n}\n\nif (newRows.length === 0) {\n  return [{\n    json: {\n      _noNewApproved: true,\n      _message: \u0027All eligible leads are already in Approved Outreach\u0027,\n      _control: Object.assign({}, filterCounters, counters)\n    }\n  }];\n}\n\nreturn newRows.map((item) =\u003e ({\n  json: Object.assign({}, item.json, { _control: Object.assign({}, filterCounters, counters) })\n}));"
                                     },
                      "id":  "1f3a5c2e-9b4d-4f1a-8c9a-5d0e2b3a7f05",
