                  {
                      "parameters":  {
                                         "jsCode":  "const items = $input.all();\n\nconst isNoOp =\n  items.length === 1 \u0026\u0026\n  items[0].json \u0026\u0026\n  items[0].json._noNewApproved === true;\n\nif (isNoOp) {\n  return items;\n}\n\nconst approvedAt = new Date().toISOString();\n\nreturn items.map((item) =\u003e {\n  const lead = item.json || {};\n\n  return {\n    json: {\n      lead_id: String(lead.lead_id || \u0027\u0027).trim(),\n      business_name: String(lead.business_name || \u0027\u0027).trim(),\n      niche: String(lead.niche || \u0027\u0027).trim(),\n      city: String(lead.city || \u0027\u0027).trim(),\n      state: String(lead.state || \u0027\u0027).trim(),\n      country: String(lead.country || \u0027\u0027).trim(),\n      website: String(lead.website || \u0027\u0027).trim(),\n      phone: String(lead.phone || \u0027\u0027).trim(),\n      email: \u0027\u0027,\n      contact_name: \u0027\u0027,\n      contact_title: \u0027\u0027,\n      email_source: \u0027\u0027,\n      email_verified: \u0027\u0027,\n      contact_form: \u0027\u0027,\n      linkedin_url: \u0027\u0027,\n      lead_score: lead.score ?? \u0027\u0027,\n      qualification_status: String(lead.qualification_status || \u0027\u0027).trim(),\n      outreach_channel: \u0027\u0027,\n      outreach_status: \u0027not_ready\u0027,\n      approved_at: approvedAt,\n      notes: \u0027\u0027\n    }\n  };\n});"
                                     },
