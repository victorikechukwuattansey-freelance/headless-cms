# Copy to .env and fill in to enable live Paystack calls.
# Loaded at launch via Node's --env-file-if-exists flag (app code does not load
# .env itself). Leave unset/empty for demo mode: CSV intake and mock-provider
# flows do not require a Paystack key.
#
# STOREFRONT_PAYSTACK_SECRET_KEY=sk_test_your_key_here
#
# Optional overrides (defaults shown):
# STOREFRONT_PORT=8787
# STOREFRONT_DATA_DIR=./data
# STOREFRONT_PAYSTACK_BASE_URL=https://api.paystack.co
# STOREFRONT_CALLBACK_BASE_URL=http://localhost:8787
# STOREFRONT_SEED_DEMO=1
