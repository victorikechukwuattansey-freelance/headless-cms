# Copy to .env and fill in values as needed.
# Prisma does NOT strip surrounding quotes from env values. Do not quote
# DATABASE_URL. See PHASE_5B_DURABLE_PERSISTENCE_SCOPE.md §3.1.

STOREFRONT_PORT=8787
STOREFRONT_DATA_DIR=
STOREFRONT_SEED_DEMO=
STOREFRONT_PAYSTACK_SECRET_KEY=
STOREFRONT_PAYSTACK_BASE_URL=https://api.paystack.co
STOREFRONT_CALLBACK_BASE_URL=

DATABASE_URL=postgresql://reconcilekit:reconcilekit@localhost:5434/reconcilekit?schema=public
