{
  "name": "reconcilekit",
  "version": "0.1.0",
  "description": "Open-source, CLI-first TypeScript toolkit that reconciles merchant-side payment records against Paystack transaction records using transaction references as the primary matching key.",
  "type": "module",
  "private": true,
  "bin": {
    "reconcilekit": "./src/cli/index.ts"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "lint": "eslint .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "csv-parse": "7.0.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
